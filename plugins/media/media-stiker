import baileysPkg from "@whiskeysockets/baileys";
import { sticker } from "../../lib/sticker.js";

const { downloadMediaMessage } = baileysPkg;

export default {
  command: ["sticker", "s", "stiker", "stikera", "sanim", "sanimado"],
  category: "Media",
  description:
    "Convierte una imagen, gif o video corto en sticker (estático o animado).",

  run: async (sock, msg, args, context) => {
    const { chatId } = context;

    const contextInfo = msg.message?.extendedTextMessage?.contextInfo;
    const mensajeCitado = contextInfo?.quotedMessage;

    let mensajeObjetivo = msg;

    if (mensajeCitado?.imageMessage || mensajeCitado?.videoMessage) {
      mensajeObjetivo = {
        key: {
          remoteJid: chatId,
          id: contextInfo.stanzaId,
          participant: contextInfo.participant,
        },
        message: mensajeCitado,
      };
    }

    const tieneImagen = Boolean(mensajeObjetivo.message?.imageMessage);
    const tieneVideo = Boolean(mensajeObjetivo.message?.videoMessage);

    if (!tieneImagen && !tieneVideo) {
      return await sock.sendMessage(
        chatId,
        {
          image: {
            url: "https://i.ibb.co/DDYYkBjy/3975511c-8f9b-48e3-89da-7b9d537425bd.png",
          },
          caption:
            `╭━━⬣ *SAITAMA-MD* ⚡\n` +
            `│\n` +
            `│ 📸 *¿Cómo crear un sticker?*\n` +
            `│\n` +
            `│ *Modo 1 — Imagen con caption:*\n` +
            `│  1. Selecciona una imagen o video corto\n` +
            `│  2. En el caption escribe *sticker*\n` +
            `│  3. Envía ✅\n` +
            `│\n` +
            `│ *Modo 2 — Citar imagen/video:*\n` +
            `│  1. Cita cualquier imagen o video\n` +
            `│  2. Escribe *sticker* y envía ✅\n` +
            `│\n` +
            `│ ⚠️ _Solo imágenes, gif o videos cortos_\n` +
            `│\n` +
            `╰━━━━━━━━━━━━━━━━━━━━━━⬣`,
        },
        { quoted: msg }
      );
    }

    await sock.sendMessage(
      chatId,
      {
        text:
          `╭━━⬣ *SAITAMA-MD* ⚡\n` +
          `│\n` +
          `│ ⏳ _Creando tu sticker..._\n` +
          `│\n` +
          `╰━━━━━━━━━━━━━━━━━━━━━━⬣`,
      },
      { quoted: msg }
    );

    try {
      const buffer = await downloadMediaMessage(mensajeObjetivo, "buffer", {});

      const stickerBuffer = await sticker(buffer, {
        packname: "SAITAMA-MD",
        author: "SAITAMA",
        categories: ["👊", "💥"],
      });

      await sock.sendMessage(
        chatId,
        { sticker: stickerBuffer },
        { quoted: msg }
      );
    } catch (err) {
      console.log(err);
      await sock.sendMessage(
        chatId,
        {
          text:
            `╭━━⬣ *SAITAMA-MD* ⚡\n` +
            `│\n` +
            `│ ❌ _Ocurrió un error al crear el sticker_\n` +
            `│ 🔁 Intenta con otra imagen o video\n` +
            `│\n` +
            `╰━━━━━━━━━━━━━━━━━━━━━━⬣`,
        },
        { quoted: msg }
      );
    }
  },
};
